{
  "name": "ergonomic-ar",
  "version": "2.0.0",
  "description": "Production-ready WebAR starter for surface detection using A-Frame and WebXR - visualize ergonomic zones on workplace desks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write \"src/**/*.{js,ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,html,css,json}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/salyafei/ergonomic-ar.git"
  },
  "keywords": [
    "webxr",
    "ar",
    "augmented-reality",
    "aframe",
    "threejs",
    "surface-detection",
    "webgl",
    "ergonomics",
    "workplace-health",
    "desk-setup"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/salyafei/ergonomic-ar/issues"
  },
  "homepage": "https://salyafei.github.io/ergonomic-ar/",
  "dependencies": {
    "aframe": "^1.5.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.1.1"
  },
  "browserslist": [
    "iOS >= 12",
    "Android >= 9",
    "Chrome >= 87",
    "Safari >= 12"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
